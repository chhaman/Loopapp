# Copy to .env.local for local development. Never commit real values.

# Supabase (optional: without these the app runs in catalog-only mode, no accounts).
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (or legacy "anon" key). Safe to expose to the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: serve miniapps from a separate origin (e.g. https://apps.loopapp.example).
# Empty = same origin, still isolated by the iframe sandbox + CSP.
NEXT_PUBLIC_MINIAPP_ORIGIN=

# Test-only page /test-harness used by the E2E security tests. Never enable in production.
NEXT_PUBLIC_ENABLE_TEST_HARNESS=
